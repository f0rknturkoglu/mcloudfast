msgid "Light mode theme"
msgstr "Tema per la modalità chiara"

#: src/ui/settings.rs:1200
msgid ""
"Used while your computer is in light mode. Only light themes are listed."
msgstr ""
"Usato quando il computer è in modalità chiara. Sono elencati solo i temi "
"chiari."

#: src/ui/settings.rs:1204
msgid "Dark mode theme"
msgstr "Tema per la modalità scura"

#: src/ui/settings.rs:1207
msgid "Used while your computer is in dark mode. Only dark themes are listed."
msgstr ""
"Usato quando il computer è in modalità scura. Sono elencati solo i temi "
"scuri."

#: src/ui/settings.rs:1224
msgid "Follow system uses your Omarchy colours."
msgstr "Segui il sistema usa i tuoi colori di Omarchy."

#: src/ui/settings.rs:1228
msgid "Follow system uses your desktop's light or dark appearance."
msgstr "Segui il sistema usa l’aspetto chiaro o scuro del tuo desktop."

