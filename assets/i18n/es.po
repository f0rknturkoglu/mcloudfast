msgstr "Spotifast {version} • sin relación con Spotify"

#: src/ui/login.rs:170
msgid ""
"That doesn't look like a Client ID. It is 32 letters and digits, shown on "
"your app's page in the dashboard."
msgstr ""
"Eso no parece un Client ID. Tiene 32 letras y números, y aparece en la "
"página de tu app en el panel."

#: src/ui/login.rs:174
msgid ""
"Spotify doesn't know this Client ID. Copy it again from your app's page in "
"the dashboard."
msgstr ""
"Spotify no reconoce este Client ID. Vuelve a copiarlo desde la página de tu "
"app en el panel."

#: src/ui/login.rs:178
msgid ""
"Spotify didn't let this account use the app. Sign in with the Spotify "
"account that created it, which needs Premium."
msgstr ""
"Spotify no ha permitido que esta cuenta use la app. Inicia sesión con la "
"cuenta de Spotify que la creó, que necesita Premium."

#: src/ui/login.rs:182
msgid ""
"Spotify no longer accepts the shared sign-in Spotifast used before. Set up "
"your own Spotify app to keep listening."
msgstr ""
"Spotify ya no acepta el inicio de sesión compartido que Spotifast usaba "
"antes. Configura tu propia app de Spotify para seguir escuchando."

#: src/ui/login.rs:219
msgid "A native Spotify client."
msgstr "Un cliente nativo de Spotify."

#: src/ui/login.rs:233
msgid "Waiting for Spotify in your browser…"
msgstr "Esperando a Spotify en tu navegador…"

#: src/ui/login.rs:241
msgid "Didn't open? Open the sign-in page again"
msgstr "¿No se abrió? Abre la página de inicio de sesión otra vez"

