msgstr "끄면 메뉴에 둡니다."

#: src/ui/settings.rs:1460
msgid "What's New as cards"
msgstr "새로운 소식을 카드로"

#: src/ui/settings.rs:1461
msgid "Off shows the list of songs."
msgstr "끄면 노래 목록을 표시합니다."

#: src/ui/settings.rs:1465
msgid "Apple Music cards on Home"
msgstr "홈에 Apple Music 카드"

#: src/ui/settings.rs:1466
msgid "Off draws Spotify's cards."
msgstr "끄면 Spotify 카드를 그립니다."

#: src/ui/settings.rs:1470
msgid "Search results in sections"
msgstr "검색 결과를 섹션으로"

#: src/ui/settings.rs:1471
msgid "Off uses Spotify's tabbed list."
msgstr "끄면 Spotify의 탭 목록을 사용합니다."

#: src/ui/settings.rs:1475
msgid "Photo headers as artwork"
msgstr "사진 헤더를 커버로"

#: src/ui/settings.rs:1476
