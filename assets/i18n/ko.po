msgstr "커버 아래 가사"

#: src/ui/settings.rs:1431
msgid "Off leaves the lyrics for full screen."
msgstr "끄면 가사는 전체 화면에서만 표시됩니다."

#: src/ui/settings.rs:1435
msgid "Artwork in the player"
msgstr "플레이어의 커버"

